<?xml version="1.0"?>
<sdf version="1.6">
  <world name="airport_search_field">
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 90 0 0 0</pose>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.25 -0.9</direction>
    </light>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>

      <update_rate>1.0</update_rate>
    </plugin>
       

    <!-- Field size is X Y Z. Change X to tune overall length and Y to tune width. -->
    <model name="airport_flat_field">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="grass_visual">
          <!-- Visual layers sit below the common collision surface (z = 0.01). -->
          <pose>0 0 0.008 0 0 0</pose>
          <geometry>
            <box>
              <size>360 120 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.48 0.24 1</ambient>
            <diffuse>0.36 0.56 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="flat_ground_collision">
          <geometry>
            <box>
              <size>360 150 0.02</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Two horizontal strips: runway above, taxiway below. -->
    <model name="runway_04_22">
      <static>true</static>
      <pose>0 18 0.005 0 0 0</pose>
      <link name="link">
        <visual name="runway_visual">
          <pose>0 0 0.0065 0 0 0</pose>
          <geometry>
            <box>
              <size>300 14 0.001</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://asphalt_plane/materials/scripts</uri>
              <uri>model://asphalt_plane/materials/textures</uri>
              <name>vrc/asphalt</name>
            </script>
          </material>
        </visual>
        <collision name="runway_collision">
          <geometry>
            <box>
              <size>300 14 0.01</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

