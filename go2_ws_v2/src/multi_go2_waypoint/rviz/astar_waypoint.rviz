Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /AStar Map1
        - /AStar Planned Paths1
        - /AStar Actual Paths1
      Splitter Ratio: 0.55
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: world
      Value: true
    - Alpha: 0.80
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: AStar Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /astar_map
      Update Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /astar_map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/RobotModel
          Description Source: Topic
          Description Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_1/robot_description
          Enabled: true
          Name: go2_1
          TF Prefix: ""
          Update Interval: 0
          Value: true
          Visual Enabled: true
        - Class: rviz_default_plugins/RobotModel
          Description Source: Topic
          Description Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_2/robot_description
          Enabled: true
          Name: go2_2
          TF Prefix: ""
          Update Interval: 0
          Value: true
          Visual Enabled: true
        - Class: rviz_default_plugins/RobotModel
          Description Source: Topic
          Description Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_3/robot_description
          Enabled: true
          Name: go2_3
          TF Prefix: ""
          Update Interval: 0
          Value: true
          Visual Enabled: true
      Enabled: true
      Name: Robots
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Path
          Color: 230; 38; 38
          Enabled: true
          Line Style: Lines
          Line Width: 0.10
          Name: go2_1 AStar plan
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_1/astar_plan
          Value: true
        - Class: rviz_default_plugins/Path
          Color: 25; 190; 50
          Enabled: true
          Line Style: Lines
          Line Width: 0.10
          Name: go2_2 AStar plan
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_2/astar_plan
          Value: true
        - Class: rviz_default_plugins/Path
          Color: 38; 88; 240
          Enabled: true
          Line Style: Lines
          Line Width: 0.10
          Name: go2_3 AStar plan
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_3/astar_plan
          Value: true
      Enabled: true
      Name: AStar Planned Paths
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Path
          Color: 255; 120; 120
          Enabled: true
          Line Style: Lines
          Line Width: 0.12
          Name: go2_1 actual
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_1/astar_actual_path
          Value: true
        - Class: rviz_default_plugins/Path
          Color: 105; 255; 125
          Enabled: true
          Line Style: Lines
          Line Width: 0.12
          Name: go2_2 actual
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_2/astar_actual_path
          Value: true
        - Class: rviz_default_plugins/Path
          Color: 105; 145; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.12
          Name: go2_3 actual
          Pose Style: None
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /go2_3/astar_actual_path
          Value: true
      Enabled: true
      Name: AStar Actual Paths
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /astar_encircle_markers
      Name: AStar Target and Goals
      Namespaces:
        astar_goal_labels: true
        astar_goals: true
        astar_target: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 34; 37
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Airport Top View
      Near Clip Distance: 0.01
      Scale: 2.0
      Target Frame: world
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 960
  Width: 1500
  X: 40
  Y: 40
